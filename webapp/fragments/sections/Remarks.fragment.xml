<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <VBox id="idAprCboxRem">
        <List id="idAprHistLst" items="{viewModel>/remarkHistory}">
            <FeedListItem id="idAprFd"
                sender="{viewModel>Approver}"
                senderActive="false"
                info="{viewModel>ActionStage}"
                icon="sap-icon://person-placeholder"
                iconDisplayShape="Square"
                iconSize="M"
                iconActive="false"
                timestamp="{
        parts: [
            'viewModel>ActionDate',
            'viewModel>ActionTime'
        ],
        formatter: '.formatter.formatHistoryDateTime'
    }"
                text="{viewModel>Remarks}"
            />
        </List>
    </VBox>
</core:FragmentDefinition>
